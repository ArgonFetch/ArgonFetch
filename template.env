# Database Configuration
POSTGRES_USER=argonfetch
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=argonfetch
DB_PORT=5432


# Application Configuration
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# CORS Configuration
# Comma-separated list of allowed origins
# Example: https://app.argonfetch.dev,https://argonfetch.dev,http://localhost:4200
CORS_ALLOWED_ORIGINS=https://app.argonfetch.dev
# Proxy Configuration
# Optional file with one proxy per line (http://user:pass@host:port or socks5://host:port),
# rotated across yt-dlp fetches. Mount it into the container and point this at it.
# PROXY_LIST_PATH=/config/proxies.txt
